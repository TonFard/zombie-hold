{
  "name": "zombie-hold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "黎明：第一人称 3D 据点防守",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "sim:nav": "tsx scripts/sims/nav.ts",
    "sim:combat": "tsx scripts/sims/combat.ts",
    "sim:build": "tsx scripts/sims/build.ts",
    "sim:run": "tsx scripts/sims/run.ts",
    "sim:meta": "tsx scripts/sims/meta.ts",
    "sim:extras": "tsx scripts/sims/extras.ts",
    "sim:progress": "tsx scripts/sims/progress.ts",
    "sim:stats": "tsx scripts/sims/stats.ts",
    "sim:stars": "tsx scripts/sims/stars.ts",
    "sim:zombies": "tsx scripts/sims/zombies.ts",
    "sim:events": "tsx scripts/sims/events.ts",
    "sim:loot": "tsx scripts/sims/loot.ts",
    "check:balance": "tsx scripts/check-balance.ts",
    "check:props": "tsx scripts/tools/check-props.ts",
    "check:deps": "tsx scripts/tools/check-deps.ts",
    "tacz:import": "node scripts/tools/tacz-import.mjs",
    "tacz:shots": "node scripts/tools/tacz-shots.mjs",
    "props:import": "node scripts/tools/props-import.mjs",
    "assets:catalog": "tsx scripts/tools/konbini-catalog.ts",
    "desktop": "vite build && node electron/run.cjs",
    "desktop:dev": "node electron/run.cjs --dev",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.187.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "main": "electron/main.cjs",
  "author": "TonFard",
  "build": {
    "appId": "com.tonfard.zombiehold",
    "productName": "Dawn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Dawn"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "黎明",
      "artifactName": "Dawn-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Dawn-Portable-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
